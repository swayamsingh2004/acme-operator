# Required: Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Models (defaults shown). Flash-Lite is the default because the free tier allows only
# 20 requests/day on gemini-3.8-flash (a run needs ~40-80). With billing enabled,
# gemini-3.8-flash is the recommended primary (fallback: gemini-3.5-flash-lite).
OPERATOR_MODEL=gemini-3.5-flash-lite
VERIFIER_MODEL=gemini-3.5-flash-lite
OPERATOR_THINKING=high
VERIFIER_THINKING=medium

# If the primary model is overloaded (503/timeout), runs switch to this model. Empty = no fallback.
FALLBACK_MODEL=gemini-3-flash-preview
PRIMARY_TIMEOUT_MS=150000
# Minimum gap between API requests (keeps free-tier keys under their rate limits)
MIN_REQUEST_INTERVAL_MS=4000

# Run limits
OPERATOR_MAX_TURNS=150
OPERATOR_MAX_COST_USD=10   # list-price equivalent; free tier is not charged

# Show the operator's Chromium window (false = headless)
OPERATOR_HEADED=false
